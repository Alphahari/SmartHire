{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend-flask",
      "type": "shell",
      "command": "cd server && source venv/bin/activate && python3 app.py",
      "problemMatcher": []
    },
    {
      "label": "ai-interview-backend",
      "type": "shell",
      "command": "cd AI-Interview-Backend && source venv/bin/activate && python3 app.py",
      "problemMatcher": []
    },
    {
      "label": "go-server",
      "type": "shell",
      "command": "cd ProctorX-executor && go run .",
      "problemMatcher": []
    },
    {
      "label": "frontend-next",
      "type": "shell",
      "command": "cd client-side && npm run dev",
      "problemMatcher": []
    },
    {
      "label": "celery-worker",
      "type": "shell",
      "command": "cd server && source venv/bin/activate && celery -A celery_worker.celery worker --loglevel=info",
      "problemMatcher": []
    },
    {
      "label": "docker-compose",
      "type": "shell",
      "command": "cd server && docker compose up -d",
      "problemMatcher": []
    },
    {
      "label": "start-services",
      "dependsOn": [
        "backend-flask",
        "ai-interview-backend",
        "go-server",
        "frontend-next",
        "celery-worker"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "start-all",
      "dependsOn": [
        "docker-compose",
        "start-services"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}